{{!
    @template local_repeatable/edit_form
    @copyright 2026 Anderson Blaine

    Repeatable profile field edit form table.

    The wrapper is described by the error region of the form group that carries the field's
    value (errorid), so a server-side validation error is announced with the widget. That region
    lives outside this template, so the example context leaves errorid out.

    columnsjson is the JSON of columns that repeatable.js builds the inputs from; the header
    cells come from the same columns.

    Example context (json):
    {
        "fieldlabel": "Repeatable test",
        "labelid": "local-repeatable-1-0-repeatable_test-label",
        "wrapperid": "local-repeatable-1-0-repeatable_test",
        "setcolumn": "Set",
        "actioncolumn": "Action",
        "addnewset": "Add new set",
        "columnsjson": "[]",
        "columns": [
            {"key": "name", "label": "Name", "required": true},
            {"key": "role", "label": "Role", "required": false}
        ]
    }
}}
<label id="{{labelid}}" class="d-block mb-2">{{fieldlabel}}</label>
<div id="{{wrapperid}}" class="local-repeatable-wrapper" data-region="repeatable-wrapper"
    role="group" aria-labelledby="{{labelid}}"{{#errorid}} aria-describedby="{{errorid}}"{{/errorid}}
    data-columns="{{columnsjson}}">
    <div class="local-repeatable-table-wrapper border rounded" data-region="table-wrapper">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col" class="position-sticky local-repeatable-sticky-head local-repeatable-head-caps">{{setcolumn}}</th>
                    {{#columns}}
                        <th scope="col" class="position-sticky local-repeatable-sticky-head">{{label}}{{#required}}<abbr class="local-repeatable-required" title="{{#str}}required{{/str}}">*</abbr>{{/required}}</th>
                    {{/columns}}
                    <th scope="col" class="position-sticky local-repeatable-sticky-head local-repeatable-head-caps text-center">{{actioncolumn}}</th>
                </tr>
            </thead>
            <tbody data-region="sets" class="local-repeatable-sets">
            </tbody>
        </table>
    </div>
    <button type="button" class="btn btn-secondary mt-2" data-action="addset">{{addnewset}}</button>
</div>
